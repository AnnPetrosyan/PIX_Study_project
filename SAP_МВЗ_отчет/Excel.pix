      <AbstractStep z:Id="i15" i:type="ExecutedStep">
        <Childs />
        <HeightOnFlowchart>50</HeightOnFlowchart>
        <Id>cf28d6d2-1665-43b1-a236-fd0bd79aa4e1</Id>
        <Parent z:Ref="i2" />
        <PositionOnFlowchart xmlns:d5p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
        <PropertyValues>
          <PropertyValue z:Id="i16">
            <PropertyName>CSCode</PropertyName>
            <_dataType>Expression</_dataType>
            <_expression>@"// Создаём новый DataTable с нужными типами колонок
var resultTable = new System.Data.DataTable();
resultTable.Columns.Add(sapDataTable.Columns[0].ColumnName, typeof(decimal));  // Виды затрат — число
resultTable.Columns.Add(sapDataTable.Columns[1].ColumnName, typeof(string));   // Названия — текст
resultTable.Columns.Add(sapDataTable.Columns[2].ColumnName, typeof(decimal));  // Значения — число
resultTable.Columns.Add(sapDataTable.Columns[3].ColumnName, typeof(int));      // Количество — целое
resultTable.Columns.Add(sapDataTable.Columns[4].ColumnName, typeof(string));   // Ед. изм. — текст

foreach (System.Data.DataRow row in sapDataTable.Rows)
{
    var newRow = resultTable.NewRow();
    
    // Колонка 0: Виды затрат (число, без знаков после запятой)
    string val0 = row[0].ToString().Trim();
    if (!string.IsNullOrEmpty(val0) &amp;&amp; !char.IsLetter(val0[0]))
    {
        string clean0 = val0.Replace(""."", """");
        if (decimal.TryParse(clean0, out decimal num0))
            newRow[0] = num0;
    }
    
    // Колонка 1: Названия (текст)
    newRow[1] = row[1].ToString().Trim();
    
    // Колонка 2: Значения (число с двумя знаками после запятой)
    string val2 = row[2].ToString().Trim();
    if (!string.IsNullOrEmpty(val2) &amp;&amp; !char.IsLetter(val2[0]))
    {
        if (val2.EndsWith(""-""))
        {
            string clean2 = val2.TrimEnd('-').Replace(""."", """").Replace("","", ""."");
            if (decimal.TryParse(clean2, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal num2))
                newRow[2] = -num2;
        }
        else if (val2.Contains("",""))
        {
            string clean2 = val2.Replace(""."", """").Replace("","", ""."");
            if (decimal.TryParse(clean2, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal num2))
                newRow[2] = num2;
        }
        else
        {
            string clean2 = val2.Replace(""."", """");
            if (decimal.TryParse(clean2, out decimal num2))
                newRow[2] = num2;
        }
    }
    
    // Колонка 3: Количество (целое)
    string val3 = row[3].ToString().Trim();
    if (!string.IsNullOrEmpty(val3) &amp;&amp; !char.IsLetter(val3[0]))
    {
        if (val3.EndsWith(""-""))
        {
            string clean3 = val3.TrimEnd('-').Replace(""."", """").Replace("","", ""."");
            if (decimal.TryParse(clean3, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal num3))
                newRow[3] = (int)(-num3);
        }
        else
        {
            string clean3 = val3.Replace(""."", """").Replace("","", ""."");
            if (decimal.TryParse(clean3, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal num3))
                newRow[3] = (int)num3;
        }
    }
    
    // Колонка 4: Единица измерения (текст)
    newRow[4] = row[4].ToString().Trim();
    
    resultTable.Rows.Add(newRow);
}

// Заменяем исходную таблицу на новую
sapDataTable = resultTable;"</_expression>
