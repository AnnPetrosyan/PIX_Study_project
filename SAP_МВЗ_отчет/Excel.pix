      <AbstractStep z:Id="i13" i:type="ExecutedStep">
        <Childs />
        <HeightOnFlowchart>50</HeightOnFlowchart>
        <Id>ac2fd2ba-e028-4df3-a3c7-374ac7cd15a7</Id>
        <Parent z:Ref="i2" />
        <PositionOnFlowchart xmlns:d5p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
        <PropertyValues>
          <PropertyValue z:Id="i14">
            <PropertyName>CSCode</PropertyName>
            <_dataType>Expression</_dataType>
            <_expression>@"foreach (System.Data.DataRow row in sapDataTable.Rows)
{
    for (int i = 0; i &lt; sapDataTable.Columns.Count; i++)
    {
        string val = row[i].ToString().Trim();
        if (string.IsNullOrEmpty(val)) continue;
        if (char.IsLetter(val[0])) continue;
        
        // Столбец количества (индекс 3, нумерация с 0)
        if (i == 3)
        {
            if (val.EndsWith(""-""))
            {
                string clean = val.TrimEnd('-').Replace(""."", """").Replace("","", ""."");
                if (decimal.TryParse(clean, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal num))
                    row[i] = (-num).ToString(""0"", System.Globalization.CultureInfo.InvariantCulture);
            }
            else
            {
                string clean = val.Replace(""."", """").Replace("","", ""."");
                if (decimal.TryParse(clean, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal num))
                    row[i] = num.ToString(""0"", System.Globalization.CultureInfo.InvariantCulture);
            }
        }
        // Остальные числовые столбцы (с двумя знаками после запятой)
        else
        {
            if (val.EndsWith(""-""))
            {
                string clean = val.TrimEnd('-').Replace(""."", """").Replace("","", ""."");
                if (decimal.TryParse(clean, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal num))
                    row[i] = (-num).ToString(""0.00"", System.Globalization.CultureInfo.InvariantCulture).Replace(""."", "","");
            }
            else if (val.Contains("",""))
            {
                string clean = val.Replace(""."", """").Replace("","", ""."");
                if (decimal.TryParse(clean, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal num))
                    row[i] = num.ToString(""0.00"", System.Globalization.CultureInfo.InvariantCulture).Replace(""."", "","");
            }
            else
            {
                string clean = val.Replace(""."", """");
                if (decimal.TryParse(clean, out decimal num))
                {
                    if (clean.Length &gt;= 7)
                        row[i] = num;
                    else
                        row[i] = num.ToString(""0.00"", System.Globalization.CultureInfo.InvariantCulture).Replace(""."", "","");
                }
            }
        }
    }
}"</_expression>
            <_screenShotBase64 i:nil="true" />
            <_value i:nil="true" />
            <_xpathSettings xmlns:d7p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
          </PropertyValue>
        </PropertyValues>
