            <IsCollapsed>false</IsCollapsed>
            <Text>//Проходим по каждому заказу и записываем его в таблицу.</Text>
          </AbstractStep>
          <AbstractStep z:Id="i133" i:type="ExecutedStep">
            <Childs />
            <HeightOnFlowchart>50</HeightOnFlowchart>
            <Id>e2680461-3af0-4a2d-94de-867cbb2e597d</Id>
            <Parent z:Ref="i131" />
