      <AbstractStep z:Id="i56" i:type="ExecutedStep">
        <Childs />
        <HeightOnFlowchart>50</HeightOnFlowchart>
        <Id>c100191d-77fb-4af7-81ff-efbf2711feef</Id>
        <Parent z:Ref="i2" />
        <PositionOnFlowchart xmlns:d5p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
        <PropertyValues>
          <PropertyValue z:Id="i57">
            <PropertyName>CSCode</PropertyName>
            <_dataType>Expression</_dataType>
            <_expression>@"int created = 0;
int errors = 0;
foreach (DataRow row in allOrders.Rows)
{
    string status = row[""Статус""].ToString().Trim();
    if (status == ""Создан"")
    {
        created++;
    }
    else if (status.Contains(""Ошибка"") || status.Contains(""Не создан""))
    {
        errors++;
    }
}
this.createdCount = created;
this.errorCount = errors;
this.totalCount = allOrders.Rows.Count;"</_expression>
            <_screenShotBase64 i:nil="true" />
            <_value i:nil="true" />
            <_xpathSettings xmlns:d7p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
          </PropertyValue>
        </PropertyValues>
