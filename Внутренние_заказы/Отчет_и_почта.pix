        <SelectedOptionId i:nil="true" />
        <WidthOnFlowchart>360</WidthOnFlowchart>
        <IsCollapsed>false</IsCollapsed>
        <Text>//ДАННЫЕ ЗАГРУЖЕНЫ:
  - settings — настройки (email)
  - allOrders — все заказы</Text>
      </AbstractStep>
      <AbstractStep z:Id="i50" i:type="ExecutedStep">
        <Childs />
        <HeightOnFlowchart>50</HeightOnFlowchart>
        <Id>a7f59724-773e-43cd-ba81-e1de39f28d76</Id>
        <Parent z:Ref="i2" />
        <PositionOnFlowchart xmlns:d5p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
        <PropertyValues>
          <PropertyValue z:Id="i51">
            <PropertyName>CSCode</PropertyName>
            <_dataType>Expression</_dataType>
            <_expression>@"string emailTo = """";
string emailCC = """";
foreach (DataRow row in settings.Rows)
{
    string paramName = row[0].ToString().Trim();
    string paramValue = row[1].ToString().Trim();
    
    if (paramName == ""Отчет_отправлять_на_почту"")
    {
        emailTo = paramValue;
    }
    else if (paramName == ""Отчет_копия (CC)"")
    {
        emailCC = paramValue;
    }
}
this.emailTo = emailTo;
this.emailCC = emailCC;"</_expression>
            <_screenShotBase64 i:nil="true" />
            <_value i:nil="true" />
            <_xpathSettings xmlns:d7p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
          </PropertyValue>
        </PropertyValues>
        <SelectedOptionId i:nil="true" />
        <WidthOnFlowchart>360</WidthOnFlowchart>
        <AutoCloseMode>None</AutoCloseMode>
        <EnableStatus>true</EnableStatus>
        <ExceptionHandlingMode>Default</ExceptionHandlingMode>
        <RetryCount>-1</RetryCount>
        <Text>Получить email из настроек</Text>
        <_activityFullName>BR.Core.Base.ExecuteCSCode</_activityFullName>
      </AbstractStep>
