        <WidthOnFlowchart>360</WidthOnFlowchart>
        <IsCollapsed>false</IsCollapsed>
        <Text>//Робот принудительно закрывает все открытые Excel-файлы,
  чтобы избежать конфликтов при создании отчета.</Text>
      </AbstractStep>
      <AbstractStep z:Id="i6" i:type="ExecutedStep">
        <Childs />
        <HeightOnFlowchart>50</HeightOnFlowchart>
        <Id>f3bf019f-eacc-4d99-a747-cef375cd5015</Id>
