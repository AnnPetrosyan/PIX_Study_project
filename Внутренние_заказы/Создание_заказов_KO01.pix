                        <PropertyValues />
                        <SelectedOptionId i:nil="true" />
                        <WidthOnFlowchart>360</WidthOnFlowchart>
                        <IsCollapsed>false</IsCollapsed>
                        <Text>//Условный оператор. Если успех (S) — извлечь номер. Условие: statusType == "S". Заказ успешно сохранен, появился номер.</Text>
                      </AbstractStep>
                      <AbstractStep z:Id="i285" i:type="ExecutedStep">
                        <Childs>
                          <AbstractStep z:Id="i286" i:type="ExecutedStep">
                            <Childs>
                              <AbstractStep z:Id="i287" i:type="ExecutedStep">
                                <Childs />
                                <HeightOnFlowchart>50</HeightOnFlowchart>
                                <Id>9379d2e5-a990-4af2-a521-e4311bb8af44</Id>
                                <Parent z:Ref="i286" />
                                <PositionOnFlowchart xmlns:d17p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
                                <PropertyValues>
                                  <PropertyValue z:Id="i288">
                                    <PropertyName>CSCode</PropertyName>
                                    <_dataType>Expression</_dataType>
                                    <_expression>@"// ==========================================================
// ИЗВЛЕЧЕНИЕ НОМЕРА ЗАКАЗА ИЗ СООБЩЕНИЯ
// ==========================================================
// 1. Берём сообщение из строки состояния
// 2. Убираем текст ДО номера
// 3. Сохраняем номер в переменную orderNumber
// ==========================================================

string statusMessage = this.statusMessage;
string orderNumber = """";

// Проверяем, что сообщение не пустое
if (!string.IsNullOrEmpty(statusMessage))
{
    // Убираем текст ""Заказ вводится под номером ""
    // Оставляем только номер
    orderNumber = statusMessage.Replace(""Заказ вводится под номером "", """").Trim();
    
    // Проверяем, что номер не пустой
    if (!string.IsNullOrEmpty(orderNumber))
    {
        Console.WriteLine(""Извлечён номер заказа: "" + orderNumber);
    }
    else
    {
        Console.WriteLine(""Не удалось извлечь номер из сообщения: "" + statusMessage);
    }
}
else
{
    Console.WriteLine(""Сообщение из строки состояния пустое."");
}

// Сохраняем результат в переменную
this.orderNumber = orderNumber;"</_expression>
                                    <_screenShotBase64 i:nil="true" />
                                    <_value i:nil="true" />
                                    <_xpathSettings xmlns:d19p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
                                  </PropertyValue>
                                </PropertyValues>
