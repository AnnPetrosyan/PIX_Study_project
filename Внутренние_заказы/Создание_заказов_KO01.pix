                    <PropertyValues>
                      <PropertyValue z:Id="i41">
                        <PropertyName>CSCode</PropertyName>
                        <_dataType>Expression</_dataType>
                        <_expression>@"string controllingArea = ""2600"";
if (settings != null &amp;&amp; settings.Rows.Count &gt; 0)
{
    foreach (DataRow row in settings.Rows)
    {
        string fieldName = row[0].ToString().Trim();
        string fieldValue = row[1].ToString().Trim();
        
        if (fieldName == ""Контроллинговая единица"")
        {
            controllingArea = fieldValue;
            break;
        }
    }
}
this.controllingArea = controllingArea;"</_expression>
                        <_screenShotBase64 i:nil="true" />
                        <_value i:nil="true" />
                        <_xpathSettings xmlns:d13p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
                      </PropertyValue>
                    </PropertyValues>
