      </AbstractStep>
      <AbstractStep z:Id="i34" i:type="CommentStep">
        <Childs />
        <HeightOnFlowchart>50</HeightOnFlowchart>
        <Id>ca1e79b1-e803-4ca3-9ac6-d17e3c88af7e</Id>
        <Parent z:Ref="i2" />
        <PositionOnFlowchart xmlns:d5p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
        <PropertyValues />
        <SelectedOptionId i:nil="true" />
        <WidthOnFlowchart>360</WidthOnFlowchart>
        <IsCollapsed>false</IsCollapsed>
        <Text>// Формирование списка заказов
1. Группируем заказы по видам (VA02, VK07, VV15 и т.д.)
2. Для каждого вида выводим список заказов
3. Сохраняем результат в переменную для окна сообщения
</Text>
      </AbstractStep>
      <AbstractStep z:Id="i35" i:type="ExecutedStep">
        <Childs />
        <HeightOnFlowchart>50</HeightOnFlowchart>
        <Id>0bc5c08f-330c-4e1f-bbca-28d65ec7c443</Id>
        <Parent z:Ref="i2" />
        <PositionOnFlowchart xmlns:d5p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
        <PropertyValues>
          <PropertyValue z:Id="i36">
            <PropertyName>CSCode</PropertyName>
            <_dataType>Expression</_dataType>
            <_expression>@"// ==========================================================
// ФОРМИРОВАНИЕ СПИСКА ЗАКАЗОВ С ГРУППИРОВКОЙ
// ==========================================================

string listText = ""СПИСОК ЗАКАЗОВ ПО ВИДАМ\n"" +
                  ""===========================================\n\n"";

// Группируем заказы по виду
var grouped = ordersToCreate.AsEnumerable()
    .GroupBy(r =&gt; r[""Вид заказа""].ToString());

foreach (var group in grouped)
{
    listText += ""▶ "" + group.Key + "" ("" + group.Count() + "" заказов)\n"";
    listText += ""───────────────────────────────────────\n"";
    
    int counter = 1;
    foreach (DataRow row in group)
    {
        listText += ""  "" + counter.ToString() + "". "" + 
                    row[""Краткий текст""].ToString() + ""\n"";
        counter++;
    }
    listText += ""\n"";
}

listText += ""===========================================\n"" +
            ""Всего заказов: "" + ordersToCreate.Rows.Count;

// Сохраняем результат в переменную для окна сообщения
this.ordersListText = listText;"</_expression>
            <_screenShotBase64 i:nil="true" />
            <_value i:nil="true" />
            <_xpathSettings xmlns:d7p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
          </PropertyValue>
        </PropertyValues>
        <SelectedOptionId i:nil="true" />
        <WidthOnFlowchart>360</WidthOnFlowchart>
        <AutoCloseMode>None</AutoCloseMode>
        <EnableStatus>true</EnableStatus>
        <ExceptionHandlingMode>Default</ExceptionHandlingMode>
        <RetryCount>-1</RetryCount>
        <Text>Сформировать группированный список заказов</Text>
        <_activityFullName>BR.Core.Base.ExecuteCSCode</_activityFullName>
