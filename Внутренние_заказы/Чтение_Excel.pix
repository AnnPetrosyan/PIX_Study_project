        <SelectedOptionId i:nil="true" />
        <WidthOnFlowchart>360</WidthOnFlowchart>
        <IsCollapsed>false</IsCollapsed>
        <Text>// Отбор заказов со статусом "Не создан"
1. Копируем структуру таблицы allOrders
2. Проходим по всем заказам
3. Если статус = "Не создан" — добавляем в список для создания</Text>
      </AbstractStep>
      <AbstractStep z:Id="i21" i:type="CommentStep">
        <Childs />
        <HeightOnFlowchart>50</HeightOnFlowchart>
        <Id>a7174570-2e9b-498b-bf18-b12240ef3412</Id>
        <Parent z:Ref="i2" />
        <PositionOnFlowchart xmlns:d5p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
        <PropertyValues />
        <SelectedOptionId i:nil="true" />
        <WidthOnFlowchart>360</WidthOnFlowchart>
        <IsCollapsed>false</IsCollapsed>
        <Text>//Код отбирает только те заказы, которые ещё не созданы, и сохраняет их в отдельную таблицу.</Text>
      </AbstractStep>
      <AbstractStep z:Id="i22" i:type="ExecutedStep">
        <Childs />
        <HeightOnFlowchart>50</HeightOnFlowchart>
        <Id>e0b58c82-ab16-40ec-b80d-e0412495bbe5</Id>
        <Parent z:Ref="i2" />
        <PositionOnFlowchart xmlns:d5p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
        <PropertyValues>
          <PropertyValue z:Id="i23">
            <PropertyName>CSCode</PropertyName>
            <_dataType>Expression</_dataType>
            <_expression>@"// ==========================================================
// ОТБОР ЗАКАЗОВ СО СТАТУСОМ ""Не создан""
// ==========================================================

ordersToCreate = allOrders.Clone();

foreach (DataRow row in allOrders.Rows)
{
    if (row[""Вид заказа""] != null &amp;&amp; 
        !string.IsNullOrEmpty(row[""Вид заказа""].ToString().Trim()) &amp;&amp;
        row[""Статус""] != null &amp;&amp;
        row[""Статус""].ToString().Trim() == ""Не создан"")
    {
        ordersToCreate.ImportRow(row);
    }
}

System.Console.WriteLine(""Найдено заказов для создания: "" + ordersToCreate.Rows.Count);"</_expression>
            <_screenShotBase64 i:nil="true" />
            <_value i:nil="true" />
            <_xpathSettings xmlns:d7p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
