        <WidthOnFlowchart>360</WidthOnFlowchart>
        <IsCollapsed>false</IsCollapsed>
        <Text>// ОТБОР ЗАКАЗОВ СО СТАТУСОМ "Создан"
1. Копируем структуру таблицы allOrders
2. Проходим по всем заказам
3. Если статус = "Создан" — добавляем в список для заполнения правил</Text>
      </AbstractStep>
      <AbstractStep z:Id="i14" i:type="ExecutedStep">
        <Childs />
        <HeightOnFlowchart>50</HeightOnFlowchart>
        <Id>7abd91d8-3e1a-4bb3-82bd-e48300e4d380</Id>
        <Parent z:Ref="i2" />
        <PositionOnFlowchart xmlns:d5p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
        <PropertyValues>
          <PropertyValue z:Id="i15">
            <PropertyName>CSCode</PropertyName>
            <_dataType>Expression</_dataType>
            <_expression>@"// ==========================================================
// ОТБОР ЗАКАЗОВ СО СТАТУСОМ ""Создан""
// ==========================================================

createdOrders = allOrders.Clone();

foreach (DataRow row in allOrders.Rows)
{
    if (row[""Статус""] != null &amp;&amp; 
        row[""Статус""].ToString().Trim() == ""Создан"")
    {
        createdOrders.ImportRow(row);
    }
}

Console.WriteLine(""Найдено заказов для заполнения правил: "" + createdOrders.Rows.Count);"</_expression>
            <_screenShotBase64 i:nil="true" />
            <_value i:nil="true" />
            <_xpathSettings xmlns:d7p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
          </PropertyValue>
        </PropertyValues>
        <SelectedOptionId i:nil="true" />
