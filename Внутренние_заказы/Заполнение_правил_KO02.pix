                        <WidthOnFlowchart>360</WidthOnFlowchart>
                        <IsCollapsed>false</IsCollapsed>
                        <Text>//ФОРМИРУЕМ XPath ДЛЯ ТЕКУЩЕЙ СТРОКИ И ПОЛУЧАЕМ ДАННЫЕ
1. Формируем XPath для каждого поля (строка = rowCounter)
2. Получаем данные из Excel
3. Сохраняем XPath и данные в переменные</Text>
                      </AbstractStep>
                      <AbstractStep z:Id="i130" i:type="ExecutedStep">
                        <Childs />
                        <HeightOnFlowchart>50</HeightOnFlowchart>
                        <Id>a8665450-f088-426c-8002-a3525d47429a</Id>
                        <Parent z:Ref="i128" />
                        <PositionOnFlowchart xmlns:d13p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
                        <PropertyValues>
                          <PropertyValue z:Id="i131">
                            <PropertyName>CSCode</PropertyName>
                            <_dataType>Expression</_dataType>
                            <_expression>@"// ==========================================================
// ФОРМИРУЕМ XPath ДЛЯ ТЕКУЩЕЙ СТРОКИ И ПОЛУЧАЕМ ДАННЫЕ
// ==========================================================

// Формируем XPath для каждого поля (строка = rowCounter)
string xpathType = ""/SapGuiElement[@Id = '/app/con[0]/ses[0]/wnd[0]/usr/tblSAPLKOBSTC_RULES/ctxtCOBRB-KONTY[0,"" + rowCounter + ""]']"";
string xpathReceiver = ""/SapGuiElement[@Id = '/app/con[0]/ses[0]/wnd[0]/usr/tblSAPLKOBSTC_RULES/ctxtDKOBR-EMPGE[1,"" + rowCounter + ""]']"";
string xpathPercent = ""/SapGuiElement[@Id = '/app/con[0]/ses[0]/wnd[0]/usr/tblSAPLKOBSTC_RULES/txtCOBRB-PROZS[3,"" + rowCounter + ""]']"";
string xpathAmount = ""/SapGuiElement[@Id = '/app/con[0]/ses[0]/wnd[0]/usr/tblSAPLKOBSTC_RULES/txtCOBRB-BETRR[5,"" + rowCounter + ""]']"";
string xpathCalcType = ""/SapGuiElement[@Id = '/app/con[0]/ses[0]/wnd[0]/usr/tblSAPLKOBSTC_RULES/ctxtCOBRB-PERBZ[7,"" + rowCounter + ""]']"";
string xpathAssignment = ""/SapGuiElement[@Id = '/app/con[0]/ses[0]/wnd[0]/usr/tblSAPLKOBSTC_RULES/ctxtCOBRB-URZUO[8,"" + rowCounter + ""]']"";

// Сохраняем XPath в переменные
this.xpathType = xpathType;
this.xpathReceiver = xpathReceiver;
this.xpathPercent = xpathPercent;
this.xpathAmount = xpathAmount;
this.xpathCalcType = xpathCalcType;
this.xpathAssignment = xpathAssignment;

// Получаем данные из Excel
string ruleType = ruleRow[""Тип""].ToString().Trim();
string ruleReceiver = ruleRow[""Получатель расчета""].ToString().Trim();
string rulePercent = ruleRow[""%""].ToString().Trim();
string ruleAmount = ruleRow[""Сумма""].ToString().Trim();
string ruleCalcType = ruleRow[""Вид расчета""].ToString().Trim();
string ruleAssignment = ruleRow[""ПрисвоениеПроисхож""].ToString().Trim();

// Сохраняем данные в переменные
this.ruleType = ruleType;
this.ruleReceiver = ruleReceiver;
this.rulePercent = rulePercent;
this.ruleAmount = ruleAmount;
this.ruleCalcType = ruleCalcType;
this.ruleAssignment = ruleAssignment;

Console.WriteLine(""Строка "" + rowCounter + "" подготовлена"");"</_expression>
                            <_screenShotBase64 i:nil="true" />
                            <_value i:nil="true" />
                            <_xpathSettings xmlns:d15p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
                          </PropertyValue>
                        </PropertyValues>
                        <SelectedOptionId i:nil="true" />
                        <WidthOnFlowchart>360</WidthOnFlowchart>
                        <AutoCloseMode>None</AutoCloseMode>
                        <EnableStatus>true</EnableStatus>
                        <ExceptionHandlingMode>Default</ExceptionHandlingMode>
                        <RetryCount>-1</RetryCount>
                        <Text>Подготовить XPath и данные для строки правил</Text>
                        <_activityFullName>BR.Core.Base.ExecuteCSCode</_activityFullName>
                      </AbstractStep>
