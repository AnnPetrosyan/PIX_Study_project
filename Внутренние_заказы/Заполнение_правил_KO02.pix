            <Parent z:Ref="i41" />
            <PositionOnFlowchart xmlns:d7p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
            <PropertyValues />
            <SelectedOptionId i:nil="true" />
            <WidthOnFlowchart>360</WidthOnFlowchart>
            <IsCollapsed>false</IsCollapsed>
            <Text>// Фильтрация правил по номеру заказа:
1. Создаём новую таблицу для отфильтрованных правил
2. Проходим по всем строкам правил
3. Если номер заказа совпадает — добавляем строку</Text>
          </AbstractStep>
          <AbstractStep z:Id="i62" i:type="ExecutedStep">
            <Childs />
            <HeightOnFlowchart>50</HeightOnFlowchart>
            <Id>a570ef0a-2ebd-4d47-b12c-a5487d49b98f</Id>
            <Parent z:Ref="i41" />
            <PositionOnFlowchart xmlns:d7p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
            <PropertyValues>
              <PropertyValue z:Id="i63">
                <PropertyName>CSCode</PropertyName>
                <_dataType>Expression</_dataType>
                <_expression>@"// ==========================================================
// ФИЛЬТРАЦИЯ ПРАВИЛ ПО НОМЕРУ ЗАКАЗА
// ==========================================================

// Создаём новую таблицу для отфильтрованных правил
DataTable filteredRules = allRules.Clone();

foreach (DataRow row in allRules.Rows)
{
    // Проверяем, что номер заказа в строке совпадает с текущим
    string ruleOrderNumber = row[""Номер заказа""].ToString().Trim();
    if (ruleOrderNumber == orderNumber)
    {
        filteredRules.ImportRow(row);
    }
}

// Сохраняем отфильтрованные правила в переменную, которую использует робот
this.rulesData = filteredRules;

Console.WriteLine(""Найдено строк правил для заказа "" + orderNumber + "": "" + filteredRules.Rows.Count);"</_expression>
                <_screenShotBase64 i:nil="true" />
                <_value i:nil="true" />
                <_xpathSettings xmlns:d9p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
              </PropertyValue>
            </PropertyValues>
            <SelectedOptionId i:nil="true" />
            <WidthOnFlowchart>360</WidthOnFlowchart>
            <AutoCloseMode>None</AutoCloseMode>
            <EnableStatus>true</EnableStatus>
            <ExceptionHandlingMode>Default</ExceptionHandlingMode>
            <RetryCount>-1</RetryCount>
            <Text>Отфильтровать правила по номеру заказа</Text>
            <_activityFullName>BR.Core.Base.ExecuteCSCode</_activityFullName>
          </AbstractStep>
