// LINQ улучшает работу с коллекциями в C#, используя примеры и объяснения различных операторов и методов LINQ. 
// LINQ (Language Integrated Query) — это компонент .NET, который добавляет встроенную возможность запроса к языку C#. 
// Он позволяет разработчикам писать запросы к коллекциям данных, используя синтаксис, похожий на SQL, 
// что делает работу с данными более понятной и удобной.

// Применение LINQ: фильтрация четных чисел
// evenNumbers = currentList.Where(n =&gt; n % 2 == 0).ToList();

// Применение LINQ: выборка квадратов чисел
// squares = currentList.Select(n =&gt; n * n).ToList();

// Применение LINQ: Сортировка элементов по возрастанию
// sortedAscending = numbers.OrderBy(n =&gt; n).ToList();

// Применение LINQ: сортировка по убыванию
// sortedDescending = currentList.OrderByDescending(n =&gt; n).ToList();

// Применение LINQ: поиск максимального и минимального значения и суммы
// max = currentList.Max();
// min = currentList.Min();
// summ = currentList.Sum();

// Применение LINQ: Сортировка элементов по возрастанию
// sortedAscending = numbers.OrderBy(n =&gt; n).ToList();

// Применение LINQ: группировка по четности
// groupedByParity = currentList.GroupBy(n =&gt; n % 2 == 0 ? "Четные" : "Нечетные");

</_value>
