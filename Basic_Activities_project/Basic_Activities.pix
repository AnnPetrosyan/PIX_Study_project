              <AbstractStep z:Id="i316" i:type="ExecutedStep">
                <Childs />
                <HeightOnFlowchart>50</HeightOnFlowchart>
                <Id>28e7cd49-623a-4afb-9b53-7aa40de470e9</Id>
                <Parent z:Ref="i312" />
                <PositionOnFlowchart xmlns:d9p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
                <PropertyValues>
                  <PropertyValue z:Id="i317">
                    <PropertyName>CSCode</PropertyName>
                    <_dataType>Value</_dataType>
                    <_expression i:nil="true" />
                    <_screenShotBase64 i:nil="true" />
                    <_value xmlns:d11p1="http://www.w3.org/2001/XMLSchema" i:type="d11p1:string">
// при создании объекта StringBuilder необходимо указать его полное квалифицированное имя
// или выполнить подключение нужного пространства имен с помощью "~System.Text" в верху документа;
System.Text.StringBuilder vowelsOnly = new();

// Список гласных букв
char[] vowels = { 'а', 'е', 'ё', 'и', 'о', 'у', 'ы', 'э', 'ю', 'я',
                  'А', 'Е', 'Ё', 'И', 'О', 'У', 'Ы', 'Э', 'Ю', 'Я' };

// Проходим по каждому символу во входной строке
foreach (char c in input)
{
    // Проверяем, является ли символ гласной буквой
    if (Array.Exists(vowels, v =&gt; v == c))
    {
        vowelsOnly.Append(c); // Добавляем гласную букву в StringBuilder
    }
}

input = vowelsOnly.ToString(); // Сохраняем только гласные буквы в input</_value>
                    <_xpathSettings xmlns:d11p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
                  </PropertyValue>
                </PropertyValues>
                <SelectedOptionId i:nil="true" />
                <WidthOnFlowchart>200</WidthOnFlowchart>
                <AutoCloseMode>None</AutoCloseMode>
                <EnableStatus>true</EnableStatus>
                <ExceptionHandlingMode>Default</ExceptionHandlingMode>
                <RetryCount>-1</RetryCount>
                <Text></Text>
                <_activityFullName>BR.Core.Base.ExecuteCSCode</_activityFullName>
              </AbstractStep>
