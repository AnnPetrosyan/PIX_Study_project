                <_dataType>Value</_dataType>
                <_expression i:nil="true" />
                <_screenShotBase64 i:nil="true" />
                <_value xmlns:d9p1="http://www.w3.org/2001/XMLSchema" i:type="d9p1:string">
// Изменение элемента по ключу. Если ключ не существует, он будет добавлен.
consumers["Покупатель_1"] = "Иванов"; 

// Сортировка по ключу или значению.
consumers = consumers
    .OrderBy(consumer =&gt; consumer.Key) // Сортировка по ключу
    .ToDictionary(kvp =&gt; kvp.Key, kvp =&gt; kvp.Value);</_value>
                <_xpathSettings xmlns:d9p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
