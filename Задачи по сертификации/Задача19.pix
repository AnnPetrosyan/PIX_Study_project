      <AbstractStep z:Id="i11" i:type="ExecutedStep">
        <Childs>
          <AbstractStep z:Id="i12" i:type="ExecutedStep">
            <Childs />
            <HeightOnFlowchart>50</HeightOnFlowchart>
            <Id>752fbf74-90a9-4fee-bc2f-2a0f660a2f87</Id>
            <Parent z:Ref="i11" />
            <PositionOnFlowchart xmlns:d7p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
            <PropertyValues>
              <PropertyValue z:Id="i13">
                <PropertyName>CSCode</PropertyName>
                <_dataType>Expression</_dataType>
                <_expression>@"using (var doc = System.IO.Packaging.Package.Open(file))
{
    var uri = new Uri(""/word/document.xml"", UriKind.Relative);
    var part = doc.GetPart(uri);
    using (var reader = new System.IO.StreamReader(part.GetStream()))
    {
        fileContent = reader.ReadToEnd();
    }
}
fileContent = System.Text.RegularExpressions.Regex.Replace(fileContent, @""&lt;[^&gt;]+&gt;"", "" "").Trim();"</_expression>
                <_screenShotBase64 i:nil="true" />
                <_value i:nil="true" />
                <_xpathSettings xmlns:d9p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
              </PropertyValue>
            </PropertyValues>
            <SelectedOptionId i:nil="true" />
            <WidthOnFlowchart>360</WidthOnFlowchart>
            <AutoCloseMode>None</AutoCloseMode>
            <EnableStatus>true</EnableStatus>
            <ExceptionHandlingMode>Default</ExceptionHandlingMode>
            <RetryCount>-1</RetryCount>
            <Text>Открываем .docx как ZIP-архив, читаем XML с текстом документа, удаляем все XML-теги, оставляя чистый текст</Text>
            <_activityFullName>BR.Core.Base.ExecuteCSCode</_activityFullName>
          </AbstractStep>
          <AbstractStep z:Id="i14" i:type="ExecutedStep">
            <Childs />
            <HeightOnFlowchart>50</HeightOnFlowchart>
            <Id>d999eba3-ea0f-43c0-9b7a-2cb16b09e43e</Id>
            <Parent z:Ref="i11" />
            <PositionOnFlowchart xmlns:d7p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
            <PropertyValues>
              <PropertyValue z:Id="i15">
                <PropertyName>CSCode</PropertyName>
                <_dataType>Expression</_dataType>
                <_expression>@"var matches = System.Text.RegularExpressions.Regex.Matches(fileContent, @""значение\s*№\s*\d+\s*[A-Z]*"");
foreach (System.Text.RegularExpressions.Match m in matches)
{
    allNumbers.Add(m.Value.Trim());
}"</_expression>
                <_screenShotBase64 i:nil="true" />
                <_value i:nil="true" />
                <_xpathSettings xmlns:d9p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
              </PropertyValue>
            </PropertyValues>
            <SelectedOptionId i:nil="true" />
            <WidthOnFlowchart>360</WidthOnFlowchart>
            <AutoCloseMode>None</AutoCloseMode>
            <EnableStatus>true</EnableStatus>
            <ExceptionHandlingMode>Default</ExceptionHandlingMode>
            <RetryCount>-1</RetryCount>
            <Text>Ищем все вхождения номеров значений (например, «значение №1 A») и добавляем их в общий список</Text>
            <_activityFullName>BR.Core.Base.ExecuteCSCode</_activityFullName>
          </AbstractStep>
