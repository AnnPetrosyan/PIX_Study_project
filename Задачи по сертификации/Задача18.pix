      <AbstractStep z:Id="i23" i:type="ExecutedStep">
        <Childs />
        <HeightOnFlowchart>50</HeightOnFlowchart>
        <Id>231ee06f-3f85-41b9-8ecd-db614ed663b5</Id>
        <Parent z:Ref="i2" />
        <PositionOnFlowchart xmlns:d5p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
        <PropertyValues>
          <PropertyValue z:Id="i24">
            <PropertyName>CSCode</PropertyName>
            <_dataType>Expression</_dataType>
            <_expression>@"var wordApp = new Microsoft.Office.Interop.Word.Application();
var doc = wordApp.Documents.Open(resultPath);
for (int i = 0; i &lt; dataTable.Rows.Count; i++)
{
    string placeholder = ""%%"" + dataTable.Rows[i][0].ToString() + ""%%"";
    string value = dataTable.Rows[i][1].ToString();
    doc.Content.Find.Execute(placeholder, ReplaceWith: value, Replace: Microsoft.Office.Interop.Word.WdReplace.wdReplaceAll);
}
doc.Save();
doc.Close();
wordApp.Quit();"</_expression>
            <_screenShotBase64 i:nil="true" />
            <_value i:nil="true" />
            <_xpathSettings xmlns:d7p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
          </PropertyValue>
