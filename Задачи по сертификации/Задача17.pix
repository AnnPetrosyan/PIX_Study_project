                    <PropertyName>CSCode</PropertyName>
                    <_dataType>Expression</_dataType>
                    <_expression>@"var bmp = new System.Drawing.Bitmap(System.Windows.Forms.Screen.PrimaryScreen.Bounds.Width, System.Windows.Forms.Screen.PrimaryScreen.Bounds.Height);
using (var g = System.Drawing.Graphics.FromImage(bmp))
{
    g.CopyFromScreen(0, 0, 0, 0, bmp.Size);
}
bmp.Save(screenshotPath, System.Drawing.Imaging.ImageFormat.Png);"</_expression>
                    <_screenShotBase64 i:nil="true" />
                    <_value i:nil="true" />
                    <_xpathSettings xmlns:d11p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
