      <AbstractStep z:Id="i8" i:type="ExecutedStep">
        <Childs />
        <HeightOnFlowchart>50</HeightOnFlowchart>
        <Id>8d45ab66-22f4-4825-9a43-8a9f3789eafa</Id>
        <Parent z:Ref="i2" />
        <PositionOnFlowchart xmlns:d5p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
        <PropertyValues>
          <PropertyValue z:Id="i9">
            <PropertyName>CSCode</PropertyName>
            <_dataType>Expression</_dataType>
            <_expression>@"resultTable = new System.Data.DataTable();
resultTable.Columns.Add(""Name"", typeof(string));
resultTable.Columns.Add(""Height"", typeof(string));"</_expression>
            <_screenShotBase64 i:nil="true" />
            <_value i:nil="true" />
            <_xpathSettings xmlns:d7p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
          </PropertyValue>
        </PropertyValues>
        <SelectedOptionId i:nil="true" />
        <WidthOnFlowchart>360</WidthOnFlowchart>
        <AutoCloseMode>None</AutoCloseMode>
        <EnableStatus>true</EnableStatus>
        <ExceptionHandlingMode>Default</ExceptionHandlingMode>
        <RetryCount>-1</RetryCount>
        <Text>Создаём пустую таблицу для результатов</Text>
        <_activityFullName>BR.Core.Base.ExecuteCSCode</_activityFullName>
      </AbstractStep>
      <AbstractStep z:Id="i10" i:type="ExecutedStep">
        <Childs>
          <AbstractStep z:Id="i11" i:type="ExecutedStep">
            <Childs />
            <HeightOnFlowchart>50</HeightOnFlowchart>
            <Id>4647307b-dbbf-4548-bd41-16669eb470a5</Id>
            <Parent z:Ref="i10" />
            <PositionOnFlowchart xmlns:d7p1="http://schemas.datacontract.org/2004/07/System.Numerics" i:nil="true" />
            <PropertyValues>
              <PropertyValue z:Id="i12">
                <PropertyName>CSCode</PropertyName>
                <_dataType>Expression</_dataType>
                <_expression>@"using (var doc = System.IO.Packaging.Package.Open(file))
{
    var uri = new Uri(""/word/document.xml"", UriKind.Relative);
    var part = doc.GetPart(uri);
    using (var reader = new System.IO.StreamReader(part.GetStream()))
    {
        fileContent = reader.ReadToEnd();
    }
}
var text = System.Text.RegularExpressions.Regex.Replace(fileContent, @""&lt;[^&gt;]+&gt;"", "" "").Trim();
var words = text.Split(new[] { ' ' }, System.StringSplitOptions.RemoveEmptyEntries);
var cleanWords = new System.Collections.Generic.List&lt;string&gt;();
foreach (var w in words)
{
    var t = w.Trim();
    if (!string.IsNullOrEmpty(t))
        cleanWords.Add(t);
}
for (int i = 0; i &lt; cleanWords.Count; i++)
{
    if (cleanWords[i] == ""HEIGHT"" &amp;&amp; i &gt; 0)
    {
        // Название породы — все слова перед HEIGHT
        var nameWords = new System.Collections.Generic.List&lt;string&gt;();
        for (int j = i - 1; j &gt;= 0; j--)
        {
            if (cleanWords[j] == ""GROUP"" || cleanWords[j] == ""BREED"" || cleanWords[j] == ""DOG"")
                break;
            nameWords.Insert(0, cleanWords[j]);
        }
        breedName = string.Join("" "", nameWords);
        
        // Рост — следующие 4 слова после HEIGHT
        height = cleanWords[i + 1] + "" "" + cleanWords[i + 2] + "" "" + cleanWords[i + 3] + "" "" + cleanWords[i + 4];
        resultTable.Rows.Add(breedName, height);
        break;
    }
}"</_expression>
                <_screenShotBase64 i:nil="true" />
                <_value i:nil="true" />
                <_xpathSettings xmlns:d9p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
              </PropertyValue>
            </PropertyValues>
            <SelectedOptionId i:nil="true" />
            <WidthOnFlowchart>360</WidthOnFlowchart>
            <AutoCloseMode>None</AutoCloseMode>
            <EnableStatus>true</EnableStatus>
            <ExceptionHandlingMode>Default</ExceptionHandlingMode>
            <RetryCount>-1</RetryCount>
            <Text></Text>
            <_activityFullName>BR.Core.Base.ExecuteCSCode</_activityFullName>
          </AbstractStep>
          <AbstractStep z:Id="i13" i:type="ExecutedStep">
